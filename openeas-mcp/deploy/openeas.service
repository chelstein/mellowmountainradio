[Unit]
Description=OpenEAS MCP server — read-only Emergency Alert System observability
Documentation=https://github.com/chelstein/mellowmountainradio/blob/main/openeas/SPEC.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openeas
Group=openeas
WorkingDirectory=/opt/openeas

# Conformance gate. 47 CFR §11.45(a) reaches recordings and simulations, so an
# EAS audio artifact must never reach a running deployment. If this fails the
# service refuses to start — deliberately, rather than starting and warning.
ExecStartPre=/usr/bin/node /opt/openeas/scripts/no-eas-audio.js

ExecStart=/usr/bin/node /opt/openeas/server.js
Restart=always
RestartSec=5

Environment=NODE_ENV=production
EnvironmentFile=-/etc/openeas/openeas.env

# Hardening. This process reads two public HTTPS feeds and serves JSON. It has
# no legitimate need for write access, privilege escalation, or device access.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @obsolete
ReadOnlyPaths=/opt/openeas
CapabilityBoundingSet=

# NOT set, deliberately — do not add these back:
#
#   MemoryDenyWriteExecute=true
#     Incompatible with any JIT runtime. V8 must map memory writable and then
#     execute it to emit JIT code; this flag forbids that, V8 aborts, and
#     systemd reports "a fatal signal was delivered causing the control process
#     to dump core". Setting it does not harden this service, it prevents it
#     from starting at all.
#
#   SystemCallFilter=~@resources
#     Blocks setrlimit and the sched_set* family, which Node uses when sizing
#     its heap and thread pool. @privileged and @obsolete are the meaningful
#     denials here and are kept.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=openeas

[Install]
WantedBy=multi-user.target
